set logtype text
capture log close
local logdate = string( d(`c(current_date)'), "%dCYND" )
log using "${LOG_PATH}SampleDescriptives_`logdate'.log", replace

******************************************************************
**	Title:		Sample descriptives: patient mix by specialist, billing
**			groups, established PCPs against all PCPs
**	Author:		Ian McCarthy
**	Date Created:	11/2/2026
**	Note:		1. Patient characteristics by specialist under the observed
**			   allocation and under a random reassignment of patients to
**			   specialists within HRR and year that keeps every specialist's
**			   volume. If the dispersion across specialists is the same under
**			   both, patients are not sorted to specialists on these
**			   characteristics.
**			2. Billing groups: surgeons per group, the share of PCP-group pairs
**			   whose referrals go to more than one surgeon in the group, and
**			   the share of referrals that stay inside the PCP's own group.
**			3. Established PCPs (the estimation sample) against all PCPs with
**			   a referral: patients per active year, active years, and new
**			   specialists per year.
**			4. Whether the endpoint of a referral is the practice or the
**			   surgeon: concentration of each PCP-practice pair's referrals
**			   across the practice's surgeons against the practice's own
**			   shares, for the TIN and for the TIN-by-office-zip definition.
**	Inputs:		${DATA_FINAL}EstReferrals.dta, PracticeYears.dta, EstPractice.dta,
**			temp_spec_yearly (from A0). Surgeon level only.
**	Output:		paper-numbers-descriptives.tex (aggregates), PatientMix_Age.png,
**			PatientMix_Specialist.csv and ReferralEndpoint.csv (aggregates
**			by group; cells under 11 pairs masked).
******************************************************************

local outfile "${RESULTS_BASE}paper-numbers-descriptives.tex"
file open fh using "`outfile'", write replace
file write fh "%% Auto-generated by S6-sample-descriptives.do" _n

******************************************************************
** 1. Patient mix by specialist, observed and under random reassignment

use "${DATA_FINAL}EstReferrals.dta", clear
keep if EstPCPMatch==3 & Year>=2013
merge m:1 Specialist_ID Year using temp_spec_yearly, keep(master match) nogenerate
bys Specialist_ID: egen max_yearly_ops=max(yearly_ops)
keep if max_yearly_ops>=${SPEC_MIN}
drop if bene_hrr==.
gen age=Year-year(bene_birthday)
gen female=(bene_gender==2) if bene_gender!=.
gen nonwhite=(bene_race!=1) if bene_race!=.
gen drg470=(clm_drg_cd==470) if clm_drg_cd!=.
keep Specialist_ID bene_hrr Year bene_id age female nonwhite drg470

** random reassignment: a permutation of the specialists across the referrals of each HRR-year
set seed 20261102
gen double u=runiform()
sort bene_hrr Year u
by bene_hrr Year: gen rnk=_n
preserve
keep bene_hrr Year Specialist_ID
sort bene_hrr Year Specialist_ID
by bene_hrr Year: gen rnk=_n
rename Specialist_ID Specialist_Random
save temp_s6_perm, replace
restore
merge 1:1 bene_hrr Year rnk using temp_s6_perm, nogenerate keep(match)
save temp_s6_patients, replace

** specialist-level means under each allocation
collapse (mean) age female nonwhite drg470 (count) n=bene_id, by(Specialist_ID)
gen allocation="observed"
save temp_s6_obs, replace
use temp_s6_patients, clear
collapse (mean) age female nonwhite drg470 (count) n=bene_id, by(Specialist_Random)
rename Specialist_Random Specialist_ID
gen allocation="random"
append using temp_s6_obs
keep if n>=${SPEC_MIN}

** dispersion across specialists under each allocation
foreach v in age female nonwhite drg470 {
	qui sum `v' [aweight=n] if allocation=="observed"
	local sd_obs_`v'=r(sd)
	qui sum `v' [aweight=n] if allocation=="random"
	local sd_rnd_`v'=r(sd)
	local w=proper("`v'")
	file write fh "\newcommand{\mixSDobs`w'}{`=string(`sd_obs_`v'', "%6.3f")'}" _n
	file write fh "\newcommand{\mixSDrnd`w'}{`=string(`sd_rnd_`v'', "%6.3f")'}" _n
	file write fh "\newcommand{\mixSDratio`w'}{`=string(`sd_obs_`v''/`sd_rnd_`v'', "%4.2f")'}" _n
}
qui count if allocation=="observed"
file write fh "\newcommand{\mixSpecialists}{`=string(r(N), "%12.0fc")'}" _n

preserve
collapse (sd) age female nonwhite drg470 [aweight=n], by(allocation)
export delimited using "${RESULTS_BASE}PatientMix_Specialist.csv", replace
restore

set scheme uncluttered
twoway (histogram age if allocation=="observed", fraction width(1) color(gray%60)) ///
	(histogram age if allocation=="random", fraction width(1) color(navy%40)), ///
	xtitle("Mean patient age of the specialist's referrals") ytitle("Share of specialists") ///
	legend(order(1 "Observed" 2 "Random reassignment within HRR and year") position(6) rows(1))
graph save "${RESULTS_BASE}PatientMix_Age", replace
graph export "${RESULTS_BASE}PatientMix_Age.png", as(png) replace

******************************************************************
** 2. Billing groups

use "${DATA_FINAL}EstReferrals.dta", clear
keep if EstPCPMatch==3 & Year>=2013
drop if spec_phy_tin1==.

** surgeons per group, among surgeons in the sample
preserve
keep spec_npi spec_phy_tin1
bys spec_npi spec_phy_tin1: keep if _n==1
bys spec_phy_tin1: gen n_surg=_N
bys spec_phy_tin1: keep if _n==1
qui count
file write fh "\newcommand{\groupN}{`=string(r(N), "%12.0fc")'}" _n
qui sum n_surg, detail
file write fh "\newcommand{\groupSurgeonsMedian}{`=string(r(p50), "%4.0f")'}" _n
file write fh "\newcommand{\groupSurgeonsPNinety}{`=string(r(p90), "%4.0f")'}" _n
qui sum n_surg
local n_groups=r(N)
qui count if n_surg==1
file write fh "\newcommand{\groupShareSolo}{`=string(100*r(N)/`n_groups', "%4.1f")'}" _n
restore

** PCP-group pairs whose referrals go to more than one surgeon in the group
preserve
keep Practice_ID spec_phy_tin1 spec_npi
bys Practice_ID spec_phy_tin1 spec_npi: keep if _n==1
bys Practice_ID spec_phy_tin1: gen n_surg_pair=_N
bys Practice_ID spec_phy_tin1: keep if _n==1
qui sum n_surg_pair
local n_pairs=r(N)
qui count if n_surg_pair>1
file write fh "\newcommand{\groupPairsMulti}{`=string(100*r(N)/`n_pairs', "%4.1f")'}" _n
restore

** referrals that stay inside the PCP's own billing group
gen same_group=(pcp_phy_tin1==spec_phy_tin1 & pcp_phy_tin1!=.)
qui sum same_group
file write fh "\newcommand{\groupShareOwn}{`=string(100*r(mean), "%4.1f")'}" _n

******************************************************************
** 3. Established PCPs against all PCPs with a referral

use "${DATA_FINAL}PracticeYears.dta", clear
merge m:1 pcp_npi using "${DATA_FINAL}EstPractice.dta", keep(master match) gen(est)
gen established=(est==3)
keep if patients>0
collapse (mean) patients unique_spec (count) years=Year, by(pcp_npi established)
foreach g in 0 1 {
	local w=cond(`g'==1,"Est","All")
	if `g'==0 {
		qui count
		file write fh "\newcommand{\pcp`w'N}{`=string(r(N), "%12.0fc")'}" _n
		qui sum patients
		file write fh "\newcommand{\pcp`w'Patients}{`=string(r(mean), "%5.1f")'}" _n
		qui sum years
		file write fh "\newcommand{\pcp`w'Years}{`=string(r(mean), "%4.1f")'}" _n
		qui sum unique_spec
		file write fh "\newcommand{\pcp`w'NewSpec}{`=string(r(mean), "%4.2f")'}" _n
	}
	else {
		qui count if established==1
		file write fh "\newcommand{\pcp`w'N}{`=string(r(N), "%12.0fc")'}" _n
		qui sum patients if established==1
		file write fh "\newcommand{\pcp`w'Patients}{`=string(r(mean), "%5.1f")'}" _n
		qui sum years if established==1
		file write fh "\newcommand{\pcp`w'Years}{`=string(r(mean), "%4.1f")'}" _n
		qui sum unique_spec if established==1
		file write fh "\newcommand{\pcp`w'NewSpec}{`=string(r(mean), "%4.2f")'}" _n
	}
}

******************************************************************
** 4. Is the endpoint of a referral the practice or the surgeon?
** For PCP-practice pairs with at least five referrals, the concentration of the pair's referrals across the
** practice's surgeons (HHI) against what the practice's own surgeon shares would give a pair of that size if
** the PCP's patients spread across the practice the way its volume does, E[HHI] = H + (1-H)/n. Excess
** concentration near zero means the practice is the endpoint; excess near 1-H means the PCP uses one surgeon.
** Two definitions of the practice: the billing TIN, and the TIN by the surgeon's performing-location zip (the
** office). Each surgeon is assigned to his modal practice over the sample. Practices with one surgeon are left out.

use "${DATA_FINAL}EstReferrals.dta", clear
keep if EstPCPMatch==3 & Year>=2013
keep Practice_ID spec_npi spec_phy_tin1 spec_phy_zip_perf1 bene_id
drop if spec_phy_tin1==. | spec_npi==.

** modal TIN per surgeon
preserve
bys spec_npi spec_phy_tin1: gen n_t=_N
bys spec_npi spec_phy_tin1: keep if _n==1
gsort spec_npi -n_t
by spec_npi: keep if _n==1
keep spec_npi spec_phy_tin1
rename spec_phy_tin1 tin
save temp_s6_tin, replace
restore

** modal TIN-zip (office) per surgeon
preserve
bys spec_npi spec_phy_tin1 spec_phy_zip_perf1: gen n_tz=_N
bys spec_npi spec_phy_tin1 spec_phy_zip_perf1: keep if _n==1
gsort spec_npi -n_tz
by spec_npi: keep if _n==1
egen double office=group(spec_phy_tin1 spec_phy_zip_perf1)
keep spec_npi office
save temp_s6_office, replace
restore

merge m:1 spec_npi using temp_s6_tin, nogenerate keep(match)
merge m:1 spec_npi using temp_s6_office, nogenerate keep(match)
save temp_s6_refs, replace

foreach def in tin office {
	use temp_s6_refs, clear

	** the practice's shares across its surgeons, its HHI, and its size
	bys `def': gen n_prac=_N
	bys `def' spec_npi: gen n_prac_s=_N
	gen sh=n_prac_s/n_prac
	bys `def' spec_npi: gen first_s=(_n==1)
	bys `def': egen hhi_prac=total(sh^2*first_s)
	bys `def': egen size_prac=total(first_s)

	** the pair's concentration across the practice's surgeons
	bys Practice_ID `def': gen n_pair=_N
	keep if n_pair>=5 & size_prac>=2
	bys Practice_ID `def' spec_npi: gen n_pair_s=_N
	gen sh_pair=n_pair_s/n_pair
	bys Practice_ID `def' spec_npi: gen first_ps=(_n==1)
	bys Practice_ID `def': egen hhi_pair=total(sh_pair^2*first_ps)
	bys Practice_ID `def': egen nsurg_pair=total(first_ps)
	gen e_hhi=hhi_prac+(1-hhi_prac)/n_pair
	gen excess=hhi_pair-e_hhi
	gen one_surg=(nsurg_pair==1)
	bys Practice_ID `def': keep if _n==1

	qui count
	file write fh "\newcommand{\endpointPairs`=proper("`def'")'}{`=string(r(N), "%12.0fc")'}" _n
	qui sum excess
	file write fh "\newcommand{\endpointExcess`=proper("`def'")'}{`=string(r(mean), "%5.3f")'}" _n
	qui sum one_surg
	file write fh "\newcommand{\endpointOneSurg`=proper("`def'")'}{`=string(100*r(mean), "%4.1f")'}" _n
	qui sum size_prac
	file write fh "\newcommand{\endpointSize`=proper("`def'")'}{`=string(r(mean), "%5.1f")'}" _n

	gen size_bin=cond(size_prac<=2,1,cond(size_prac<=5,2,cond(size_prac<=10,3,4)))
	collapse (count) n_pairs=n_pair (mean) n_pair hhi_pair e_hhi excess one_surg size_prac, by(size_bin)
	gen definition="`def'"
	save temp_s6_conc_`def', replace
}

use temp_s6_conc_tin, clear
append using temp_s6_conc_office
foreach v of varlist n_pair hhi_pair e_hhi excess one_surg size_prac {
	replace `v'=. if n_pairs<11
}
label define sizelbl 1 "2 surgeons" 2 "3-5" 3 "6-10" 4 "11+"
label values size_bin sizelbl
order definition size_bin n_pairs size_prac n_pair hhi_pair e_hhi excess one_surg
export delimited using "${RESULTS_BASE}ReferralEndpoint.csv", replace

file close fh

capture erase temp_s6_perm.dta
capture erase temp_s6_patients.dta
capture erase temp_s6_obs.dta
capture erase temp_s6_tin.dta
capture erase temp_s6_office.dta
capture erase temp_s6_refs.dta
capture erase temp_s6_conc_tin.dta
capture erase temp_s6_conc_office.dta

log close
